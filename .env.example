# Copy to .env and fill in. Never commit the filled-in file.

PORT=5000
NODE_ENV=development

# MongoDB must be a replica set — checkout runs in a transaction, and
# transactions need an oplog. docker-compose.yml starts a single-node rs0.
MONGO_URI=mongodb://localhost:27017/ecommerce?replicaSet=rs0&retryWrites=true

REDIS_URL=redis://localhost:6379

# Allowed CORS origin for the browser client.
FRONTEND_URL=http://localhost:5173

JWT_SECRET=
JWT_REFRESH_SECRET=

# Razorpay dashboard → Settings → API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay dashboard → Settings → Webhooks. Distinct from the key secret above;
# the webhook endpoint rejects every request without it.
RAZORPAY_WEBHOOK_SECRET=

AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=

SMTP_HOST=
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=
SMTP_FROM=

# Workers to fork when running `npm run start:cluster`. Defaults to CPU count.
WEB_CONCURRENCY=1
